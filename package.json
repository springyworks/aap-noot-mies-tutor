{
  "name": "rt-tutor-brain-rocket",
  "private": true,
  "version": "2.0.0",
  "description": "RT Tutor: Brain-Rocket Edition — Real-Time Cognitive Scaffolding, 2D-FFT Telemetry & Animated Aap-Noot-Mies SVG Reading Environment",
